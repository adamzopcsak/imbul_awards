# /etc/systemd/system/imbul-awards.service — Imbul Awards at imbulawards.yagi.hu
[Unit]
Description=Imbul Awards, the Game Awards vote of the Imbul Discord (imbulawards.yagi.hu)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/imbul-awards/server.py --host 127.0.0.1 --port 8006 --data /var/lib/imbul-awards
# AWARDS_PUBLIC_URL, DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, AWARDS_ADMIN_USERS (root-only file, set up by hand)
EnvironmentFile=/etc/imbul-awards.env
# Runs as a throwaway user; only /var/lib/imbul-awards is writable.
DynamicUser=yes
StateDirectory=imbul-awards
UMask=0077
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
# Sandbox: the server needs its files, a local socket for Caddy and HTTPS to Discord for the login.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
