# /etc/imbul-awards.env (root:root, mode 600). Read by the imbul-awards systemd service.
AWARDS_PUBLIC_URL=https://imbulawards.yagi.hu
# The Discord application's OAuth2 client (Developer Portal → OAuth2); the same app as Imbul Stats is fine
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord user ids of the admins, comma separated: they can always log in and see every vote
AWARDS_ADMIN_USERS=
